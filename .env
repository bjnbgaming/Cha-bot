# Rename this file to ".env" and fill in your own values.
# NEVER share this file or commit it to a public repo — your bot token is a secret.

# From Discord Developer Portal > Your App > Bot > Token
DISCORD_TOKEN=

# From Discord Developer Portal > Your App > General Information > Application ID
DISCORD_CLIENT_ID=

# Optional: your test server's ID (enable Developer Mode in Discord, right-click
# your server icon > Copy Server ID). If set, slash commands register instantly
# to that one server instead of waiting up to 1hr for global registration.
DISCORD_GUILD_ID=
